{
  "name": "pdu-parc-auto",
  "productName": "PDU Parc Auto",
  "version": "4.4.19",
  "description": "Gestion du parc automobile du PDU — application Windows autonome (un seul fichier)",
  "author": "PDU",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dev:desktop": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "start:desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win portable",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "chart.js": "^4.4.7",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode-generator": "^1.5.2",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "ci.pdu.parcauto",
    "productName": "PDU Parc Auto",
    "directories": {
      "output": "release",
      "buildResources": "resources/static/icons"
    },
    "files": [
      "public/app/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "resources/static/icons/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "PDU-Parc-Auto-${version}.exe"
    }
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
